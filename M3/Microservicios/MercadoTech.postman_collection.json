                "pm.test('Pedido cancelado por stock real', () => pm.expect(body.estado).to.eql('CANCELADO_SIN_STOCK'));",
                "pm.test('Pago conservado y envío ausente', () => { pm.expect(body.pagoId).to.be.a('number'); pm.expect(body.envioId).to.eql(null); });"
              ], "type": "text/javascript" } }],
              "request": {
