              "event": [{ "listen": "test", "script": { "exec": [
                "pm.test('Pedido creado: 201', () => pm.response.to.have.status(201));",
                "const body = pm.response.json();",
                "pm.collectionVariables.set('pedidoId', body.id);",
                "pm.test('Saga confirmada', () => pm.expect(body.estado).to.eql('CONFIRMADO'));",
                "pm.test('Pago y envío registrados', () => { pm.expect(body.pagoId).to.be.a('number'); pm.expect(body.envioId).to.be.a('number'); });"
              ], "type": "text/javascript" } }],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "X-Api-Key", "value": "{{apiKey}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": { "mode": "raw", "raw": "{\n  \"productoId\": {{productoId}},\n  \"cantidad\": 2,\n  \"monto\": 251.00\n}" },
                "url": "{{gatewayUrl}}/pedidos-service/api/pedidos"
              }
            },
