    { "key": "pedidosUrl", "value": "http://localhost:8082" },
    { "key": "configServerUrl", "value": "http://localhost:8888" },
    { "key": "discoveryUrl", "value": "http://localhost:8761" },
    { "key": "inventarioUrl", "value": "http://localhost:8083" },
    { "key": "gatewayUrl", "value": "http://localhost:8080" },
    { "key": "pagosUrl", "value": "http://localhost:8084" },
    { "key": "enviosUrl", "value": "http://localhost:8085" },
    { "key": "apiKey", "value": "mercadotech-demo-key", "type": "secret" },
    { "key": "rabbitManagementUrl", "value": "http://localhost:15672" },
    { "key": "rabbitUser", "value": "mercadotech" },
    { "key": "rabbitPassword", "value": "mercadotech", "type": "secret" },
