{
  "info": {
    "_postman_id": "3ad2d88d-867d-4db2-a111-mercadotech-m3",
    "name": "MercadoTech - Microservicios",
    "description": "Pruebas manuales de MercadoTech organizadas por bloques: comunicación síncrona, infraestructura, eventos, Resilience4j, Saga, trazabilidad y seguridad. Cada carpeta indica el orden y las condiciones de la demostración.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
